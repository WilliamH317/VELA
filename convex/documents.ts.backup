// convex/documents.ts - Day 11 Upload Mutations
// Add these functions to your existing documents.ts file

import { v } from "convex/values";
import { mutation, action, internalMutation, internalQuery } from "./_generated/server";
import { internal } from "./_generated/api";

// ===================================================================
// DAY 11: FILE UPLOAD MUTATIONS
// ===================================================================

/**
 * MUTATION 1: Generate Upload URL
 * Returns a signed URL where the client can POST files directly to Convex storage
 * 
 * Flow:
 * 1. Client calls this function
 * 2. Convex generates a temporary signed URL (expires in 5 minutes)
 * 3. Client uploads file directly to that URL
 * 4. Client receives back a storageId
 * 
 * Security: User must be authenticated
 */
export const generateUploadUrl = mutation({
  handler: async (ctx) => {
    // 1. Verify authentication
    const identity = await ctx.auth.getUserIdentity();
    if (!identity) {
      throw new Error("Not authenticated - please sign in to upload documents");
    }

    // 2. Generate and return upload URL
    // Convex handles signed URL generation automatically
    return await ctx.storage.generateUploadUrl();
  },
});

/**
 * MUTATION 2: Create Document from Uploaded File
 * Called AFTER file is uploaded to storage
 * Creates document record and schedules background processing
 * 
 * Args:
 * - fileId: Storage ID returned from file upload
 * - title: Document title (usually filename)
 * - type: "pdf" | "text" | "markdown"
 * 
 * Returns: Document ID
 */
export const createFromFile = mutation({
  args: {
    fileId: v.id("_storage"),
    title: v.string(),
    type: v.union(
      v.literal("pdf"),
      v.literal("text"),
      v.literal("markdown")
    ),
  },
  handler: async (ctx, args) => {
    // 1. Verify authentication
    const identity = await ctx.auth.getUserIdentity();
    if (!identity) {
      throw new Error("Not authenticated - please sign in to upload documents");
    }

    // 2. Validate title
    if (args.title.length === 0) {
      throw new Error("Document title cannot be empty");
    }
    if (args.title.length > 500) {
      throw new Error("Document title too long (max 500 characters)");
    }

    // 3. Get or create user record to get vertical
    // This assumes you have a users.getByClerkId or similar query
    // If not, we'll default to "musician" for now
    let userVertical = "musician"; // Default vertical
    
    try {
      // Try to get user's vertical from users table
      const user = await ctx.db
        .query("users")
        .withIndex("by_clerk_id", (q) => q.eq("clerkId", identity.subject))
        .first();
      
      if (user) {
        // Use user's vertical if available
        // You might need to add a vertical field to users table later
        // For now, defaulting to "musician"
      }
    } catch (error) {
      // If users query fails, continue with default
      console.log("Could not fetch user vertical, using default:", error);
    }

    // 4. Set MIME type based on file type
    const mimeTypeMap = {
      pdf: "application/pdf",
      text: "text/plain",
      markdown: "text/markdown",
    };

    // 5. Create document with "processing" status
    const now = Date.now();
    
    const documentId = await ctx.db.insert("documents", {
      // User & Organization
      userId: identity.subject, // Clerk user ID
      organizationId: undefined, // Not used yet
      vertical: userVertical,
      
      // Content (will be filled by background job)
      title: args.title,
      content: "", // Will be populated by processFile
      contentPlain: "", // Will be populated by processFile
      contentPreview: "", // Will be populated by processFile
      
      // Duplicate Detection (optional, can add hash later)
      contentHash: undefined,
      
      // Type
      type: args.type,
      
      // Source - Track upload metadata
      source: {
        platform: "file_upload", // 🚢 PORT upload!
        url: undefined, // No URL for direct uploads
        importedAt: now,
        importedBy: identity.subject,
      },
      
      // Chaos Metadata (not used yet - Days 16-20)
      chaosMetadata: undefined,
      
      // Tags
      tags: [], // User can add later
      autoTags: undefined, // Will be generated later
      
      // Status - Start with "processing"
      status: "processing",
      errorMessage: undefined,
      
      // File Storage
      fileId: args.fileId,
      fileSize: 0, // Will be updated by processFile
      mimeType: mimeTypeMap[args.type],
      
      // Timestamps
      createdAt: now,
      updatedAt: undefined,
      processedAt: undefined, // Will be set when processing completes
      
      // Privacy
      isPublic: false, // Private by default
    });

    // 6. Schedule background processing job
    // This runs asynchronously so the UI doesn't block
    // The job will:
    // - Download the file from storage
    // - Extract text (PDF parsing or read plain text)
    // - Update the document with content
    // - Change status to "ready" or "error"
    await ctx.scheduler.runAfter(
      0, // Run immediately (0ms delay)
      internal.documents.processFile,
      { documentId }
    );

    // 7. Return document ID for client
    return documentId;
  },
});

/**
 * ACTION: Process Uploaded File (Background Job)
 * Extracts text from PDF or reads text file
 * 
 * Why ACTION (not mutation)?
 * - Can make external API calls
 * - Can read from storage (async operation)
 * - Can take longer than 1 second
 * - Can call mutations to update database
 * 
 * Flow:
 * 1. Get document from database
 * 2. Download file from storage
 * 3. Extract text based on type (PDF vs plain text)
 * 4. Update document with content
 * 5. Set status to "ready" or "error"
 * 
 * Note: This is INTERNAL (only callable by other Convex functions)
 */
export const processFile = internalAction({
  args: { 
    documentId: v.id("documents") 
  },
  handler: async (ctx, args) => {
    try {
      // 1. Get document record
      const doc = await ctx.runQuery(internal.documents.getByIdInternal, {
        id: args.documentId,
      });

      if (!doc) {
        throw new Error("Document not found");
      }

      if (!doc.fileId) {
        throw new Error("Document has no file attached");
      }

      // 2. Download file from Convex storage
      const file = await ctx.storage.get(doc.fileId);
      if (!file) {
        throw new Error("File not found in storage");
      }

      // 3. Extract text based on file type
      let extractedText = "";
      let fileSize = 0;

      if (doc.type === "pdf") {
        // === PDF TEXT EXTRACTION ===
        // Requires pdf-parse library (install with: npm install pdf-parse)
        
        try {
          // Convert blob to buffer for pdf-parse
          const arrayBuffer = await file.arrayBuffer();
          const buffer = Buffer.from(arrayBuffer);
          fileSize = buffer.length;
          
          // IMPORTANT: You need to install pdf-parse first!
          // Run: npm install pdf-parse
          // Then uncomment this section:
          
          /*
          // Import pdf-parse at the top of the file:
          // import pdfParse from "pdf-parse";
          
          const pdfData = await pdfParse(buffer);
          extractedText = pdfData.text;
          
          // Log extraction results for debugging
          console.log(`PDF processed: ${pdfData.numpages} pages, ${extractedText.length} characters`);
          */
          
          // TEMPORARY: Until pdf-parse is installed
          extractedText = `[PDF Processing Pending - Install pdf-parse]
          
File: ${doc.title}
Size: ${(fileSize / 1024).toFixed(2)} KB
Type: PDF Document

To enable PDF text extraction:
1. Run: npm install pdf-parse
2. Uncomment the pdf-parse code in processFile()
3. Upload your PDF again

For now, this document has been marked as "ready" but without extracted text.`;
          
        } catch (pdfError) {
          console.error("PDF extraction error:", pdfError);
          throw new Error(`PDF processing failed: ${pdfError}`);
        }
        
      } else {
        // === PLAIN TEXT EXTRACTION ===
        // For .txt and .md files, just read as text
        try {
          extractedText = await file.text();
          fileSize = extractedText.length;
          
          console.log(`Text file processed: ${extractedText.length} characters`);
        } catch (textError) {
          console.error("Text extraction error:", textError);
          throw new Error(`Text file reading failed: ${textError}`);
        }
      }

      // 4. Create content preview (first 200 chars)
      const contentPreview = extractedText
        .trim()
        .slice(0, 200);

      // 5. Strip any HTML/markdown for plain search
      const contentPlain = extractedText
        .replace(/<[^>]*>/g, "") // Remove HTML tags
        .replace(/[#*_~`]/g, "") // Remove markdown symbols
        .trim();

      // 6. Update document with extracted content
      await ctx.runMutation(internal.documents.updateAfterProcessing, {
        id: args.documentId,
        content: extractedText,
        contentPlain: contentPlain,
        contentPreview: contentPreview,
        fileSize: fileSize,
        status: "ready",
      });

      console.log(`✅ Document ${args.documentId} processed successfully`);

    } catch (error) {
      // === ERROR HANDLING ===
      console.error("File processing failed:", error);

      // Mark document as error state
      await ctx.runMutation(internal.documents.updateStatus, {
        id: args.documentId,
        status: "error",
        errorMessage: error instanceof Error 
          ? error.message 
          : "Unknown processing error",
      });

      console.log(`❌ Document ${args.documentId} processing failed:`, error);
    }
  },
});

/**
 * INTERNAL MUTATION: Update Document After Processing
 * Called by processFile action after successful text extraction
 * Updates content, status, and metadata
 */
export const updateAfterProcessing = internalMutation({
  args: {
    id: v.id("documents"),
    content: v.string(),
    contentPlain: v.string(),
    contentPreview: v.string(),
    fileSize: v.number(),
    status: v.literal("ready"),
  },
  handler: async (ctx, args) => {
    const now = Date.now();
    
    await ctx.db.patch(args.id, {
      content: args.content,
      contentPlain: args.contentPlain,
      contentPreview: args.contentPreview,
      fileSize: args.fileSize,
      status: args.status,
      processedAt: now,
      updatedAt: now,
    });
  },
});

/**
 * INTERNAL MUTATION: Update Status (Error Handling)
 * Called by processFile action when processing fails
 * Marks document as error state with error message
 */
export const updateStatus = internalMutation({
  args: {
    id: v.id("documents"),
    status: v.union(
      v.literal("processing"),
      v.literal("ready"),
      v.literal("error")
    ),
    errorMessage: v.optional(v.string()),
  },
  handler: async (ctx, args) => {
    const now = Date.now();
    
    await ctx.db.patch(args.id, {
      status: args.status,
      errorMessage: args.errorMessage,
      updatedAt: now,
    });
  },
});

/**
 * INTERNAL QUERY: Get Document by ID
 * Used by processFile action to fetch document details
 * Internal only - not exposed to client
 */
export const getByIdInternal = internalQuery({
  args: { 
    id: v.id("documents") 
  },
  handler: async (ctx, args) => {
    return await ctx.db.get(args.id);
  },
});

